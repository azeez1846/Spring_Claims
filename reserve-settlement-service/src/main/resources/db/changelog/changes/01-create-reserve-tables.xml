<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-create-reserves-and-ledger" author="insurtech">
        <createTable tableName="claim_reserves">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="reserve_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="claim_number" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="initial_reserve_amount" type="DECIMAL(15, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="current_reserve_amount" type="DECIMAL(15, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="paid_amount" type="DECIMAL(15, 2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createTable tableName="payout_ledger">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payout_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="claim_number" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="payout_amount" type="DECIMAL(15, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="payee_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="payment_method" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
